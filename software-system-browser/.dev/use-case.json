            {
              "path": "software-system-browser/index.html",
              "symbol": "selectKind"
            }
          ],
          "participantKind": "actor",
          "actorDocument": "Actors/reader.md"
        },
        {
          "id": "group",
          "actor": "Browser",
          "action": "Shows the files grouped as the catalogue groups them, and each record as a card: title, status and evidence badges, ID, summary, details, its own fields, origin, relationships, sources and links.",
          "sources": [
            {
              "path": "software-system-browser/index.html",
              "symbol": "knowledgePanel"
            },
            {
              "path": "software-system-browser/index.html",
              "symbol": "recordCard"
            }
          ],
          "participantKind": "system"
        },
        {
